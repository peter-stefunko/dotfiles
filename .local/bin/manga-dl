#!/usr/bin/env bash

# Author: github.com/peter-stefunko

#######################################
# Default config
#######################################

title=""
from=""
to=""
chapters=""
output_dir="$HOME/Downloads/Manga"
images_dir="" # $output_dir/$title/$title.images
output_pdf="" # $output_dir/$title.pdf
step=0.5
limit="" # $to
keep_images=false
no_pdf=false
ignore_if_fail=false

help_short="Please refer to manga-dl -h for help"
img_dl_info="Images are preserved in $images_dir"

#######################################
# User Interface (Help, Output)
#######################################

display_help() {
    cat <<EOF
Usage: manga-dl [OPTIONS] TITLE [FROM_CHAPTER] [TO_CHAPTER]

Manga Downloader Script
-----------------------
Downloads manga chapters as images and converts them to a PDF.

Arguments:
  TITLE			Manga series title. Cannot be combined with --title.
  			Format: "First-Second-Third" or "First Second Third",
  			case insensitive.
  FROM_CHAPTER		Starting chapter. Cannot be combined with --chapters or --from.
  			Format: integer or decimal, e.g., 5 or 6.5).
  			Default: 1
  TO_CHAPTER		Ending chapter. Cannot be combined with --chaptes or --to.
  			Format: integer or decimal.
  			Default: FROM_CHAPTER, or 9999 if FROM_CHAPTER is not specified.

Options:
  -T, --title NAME	Manga title (alternative to argumnet TITLE).
  -f, --from NUMBER	Starting chapter (alternative to argument FROM_CHAPTER).
  			Sets TO_CHAPTER to 9999 unless specified otherwise
  -t, --to NUMBER	Ending chapter (alternative to argument TO_CHAPTER).
  			Sets FROM_CHAPTER to 1 unless specified otherwise
  -c, --chapters RANGE	Range of chapters to download. Accepts numeric "N" and/or "M"
  			parameter(s) in the format "N,M"
  			This option is equivalent to --from N --to M
			Cannot be combined with --from, --to, or FROM/TO_CHAPTER arguments.
			Format: -c 5	(--from 5 --to 5)
				-c 5,	(--from 5)
				-c ,10	(--to 5)
				-c 5,10	(--from 5 --to 10)
  -s, --step NUMBER	Step size between chapters.
  			Default: 0.5
  -l, --limit NUM	Stop downloading after successfully downloading N chapters.
  			Default: TO_CHAPTER
  -o, --output FILE	Custom PDF filename inside the output dir.
  			Default: ~/Downloads/Manga/TITLE.pdf
  -d, --output-dir DIR	Directory for output.
  			Default: ~/Downloads/Manga
  -k, --keep		Keep downloaded images after creating PDF.
  			Default: False
  -n, --no-pdf		Do not create a PDF; only download images.
  			Default: False
  -i, --ignore-if-fail	Skip chapters that fail to download and continue with the
			next one instead of exiting the script.
			Default: False
  -h, --help		Show this help message and exit.

Examples:
  Download entire series "Oyasumi Punpun":
    manga-dl Oyasumi-Punpun

  Download chapters 5 to 30:
    manga-dl "oyasumi punpun" 5 30

  Download chapter 6.5 only:
    manga-dl dorohedoro 6.5

  Download chapters 1 to 10, keep images, custom PDF path with name:
    manga-dl --keep -o ~/Documents/Oyasumi-Punpun_1-10.pdf "Oyasumi Punpun" 1 10

  Use custom output directory, pdf name, and keep downloaded images:
    manga-dl --keep -d ~/Documents -o blame-1-to-5 Blame 1 5

  Download first 5 even chapters, do not create PDF
    manga-dl -n --title chainsaw-man --from 2 --step 2 --limit 5

  Download all bonus chapters
    manga-dl -i --title dorohedoro --chapters 0.5,168 --step 1

Dependencies:
  curl		Check if images exist on the host.
  wget		Download individual image files.
  img2pdf	Convert downloaded images into a PDF file.

Notes:
  - Only titles hosted on www.weebcentral.com are supported, look at the host
    used on the website directly if having issues with title not being found
  - Some titles have more variants, e.g.
      One-Punch Man: Onepunch-Man, Onepunch-Man/Mag-Official
      Berserk: Berserk (ch. 374+), Berserk/Part1 (prologue),
	       Berserk/Part2 (ch. 1 - 373)
EOF
}

update_progress() {
	local chapter="$1" page="$2" chapters_total="$3" pages_total="$4" reset
	reset="                                                          "

	echo -ne "\033[1A"
	echo -e "\rDownloaded:  $chapters_total chapters [$pages_total pages total]"
	echo -ne "$reset\rDownloading: Chapter $chapter [page $page]\r"
}

#######################################
# Arguments operations
#######################################

fix_title() {
	local title="$1" result

	title="${title,,}"
	title="${title//-/ }"
	result=$(for word in $title; do echo -n "${word^}-"; done)
	result="${result%-}"
	sed -E 's:/(.):/\U\1:g' <<< "$result"
}

make_decimal() {
	local num="$1"
	printf "%.1f" "$num"
}

is_integer() {
	local num="$1"
	[[ "$num" =~ ^-?[0-9]+$ ]]
}

is_decimal() {
	local num="$1"
	[[ "$num" =~ ^-?[0-9]*\.[0-9]+$ ]]
}

is_number() {
	local num="$1"
	is_integer "$num" || is_decimal "$num"
}

split_number() {
	local num="$1" num_trunc decimal

	is_integer "$num" && echo "$num;" && return

	num_trunc="${num::-2}"
	decimal="${num: -2}"
	[[ "$decimal" == ".5" ]] || decimal=""
	echo "$num_trunc;$decimal"
}

prettify_num() {
	local num="$1" num_split
	num_split="$(split_number "$num")"
	echo "${num_split//;/}"
}

#######################################
# Argument validation & resolution
#######################################

resolve_arguments() {
	local title_arg="$1" from_arg="$2" to_arg="$3"

	#----------------------------
	# Title
	#----------------------------
	if [[ -n "$title" && -n "$title_arg" ]]; then
		echo "Error: Cannot use both --title and positional TITLE" >&2
		echo "$help_short"
		exit 1
	elif [[ -n "$title_arg" ]]; then
		title="$(fix_title "$title_arg")"
	elif [[ -n "$title" ]]; then
		title="$(fix_title "$title")"
	else
		echo "Error: Missing TITLE (use --title or positional argument)" >&2
		echo "$help_short"
		exit 1
	fi

	#----------------------------
	# Chapters (mutually exclusive)
	#----------------------------
	if [[ -n "$chapters" && ( -n "$from" || -n "$to" || -n "$from_arg" || -n "$to_arg" ) ]]; then
		echo "Error: --chapters cannot be combined with --from, --to, or positional FROM/TO_CHAPTER" >&2
		echo "$help_short"
		exit 1
	fi

	if [[ -n "$chapters" ]]; then
		if [[ "$chapters" == *,* ]]; then
			from="${chapters%%,*}"
			[[ -z "$from" ]] && from=1
			to="${chapters##*,}"
			[[ -z "$to" ]] && to=9999
		else
		    from="$chapters"
		    to="$chapters"
		fi
	else
		#----------------------------
		# From / To handling
		#----------------------------
		if [[ -n "$from" && -n "$from_arg" ]]; then
			echo "Error: Cannot use both --from and positional FROM_CHAPTER" >&2
			echo "$help_short"
			exit 1
		fi
		if [[ -n "$to" && -n "$to_arg" ]]; then
			echo "Error: Cannot use both --to and positional TO_CHAPTER" >&2
			echo "$help_short"
			exit 1
		fi

		if [[ -n "$from_arg" ]]; then
			from="$from_arg"
		elif [[ -z "$from" ]]; then
			from=1
		fi

		if [[ -n "$to_arg" ]]; then
			to="$to_arg"
		elif [[ -z "$to" ]]; then
			if [[ -n "$from" && "$from" != 1 && -z "$from_arg" ]]; then
				to=9999
			else
				to="$from"
			fi
		fi
	fi

	#----------------------------
	# Numeric validation
	#----------------------------
	is_number "$step" || { echo "Error: Step must be an integer or decimal. $help_short" >&2; exit 1; }
	{ is_number "$from" && is_number "$to"; } || { echo "Error: FROM_CHAPTER and/or TO_CHAPTER must be numbers" >&2; echo "$help_short"; exit 1; }
	if (( $(echo "$from > $to" | bc -l) )); then
		echo "Error: FROM_CHAPTER cannot be greater than TO_CHAPTER." >&2
		exit 1
	fi

	from="$(make_decimal "$from")"
	to="$(make_decimal "$to")"
	[[ -z "$limit" ]] && limit="$to"
}

resolve_dirs() {
	local base_dir

	[[ -n "$output_pdf" ]] || output_pdf="$title.pdf"
	[[ "$output_pdf" == *.pdf ]] || output_pdf="$output_pdf.pdf"
	[[ "$output_pdf" == /* ]] || output_pdf="$output_dir/$output_pdf"

	base_dir="$(dirname "$output_pdf")"
	[[ -d "$base_dir" ]] || mkdir -p "$base_dir"

	images="$(basename "$output_pdf" .pdf).images"
	images_dir="$output_dir/$images"
}

#######################################
# Download and processing
#######################################

get_image_name() {
	local chapter="$1" page="$2" ch_trunc ch_decimal ch_split

	ch_split="$(split_number "$chapter")"
	IFS=';' read -r ch_trunc ch_decimal <<< "$ch_split"
	printf "%04d%s-%03d.png" "$ch_trunc" "$ch_decimal" "$page"
}

get_new_host() {
	local image="$1" hosts found

	hosts=(
		"https://hot.planeptune.us"
		"https://official.lowee.us"
		"https://scans.lastation.us"
		"https://scans-hot.planeptune.us"
	)
	found=0
	for host in "${hosts[@]}"; do
		url="$host/manga/$title"
		if curl -s --head --fail "$url/$image" > /dev/null; then
			found=1
			break
		fi
	done
	[[ "$found" -eq 1 ]]
}

find_initial_host() {
	echo "Finding host..."
	get_new_host "$(get_image_name "$from" 1)" || { [[ "$ignore_if_fail" == true ]] && return 1; } || { echo "Error: No host was found. Try both JP and EN titles of the series and make sure the entered staring chapter exists for the series" >&2; exit 1; }
}

download_image() {
	local image="$1" host

	host="$url/$image"
	wget -P "$images_dir" "$host" 1>/dev/null 2>/dev/null
}

download_images() {
	local pages_downloaded chapters_downloaded chapter_pretty page image

	pages_downloaded=0
	chapters_downloaded=0

	echo -e "Downloading chapters...\n\n"
	for chapter in $(seq "$from" "$step" "$to"); do
		chapter_pretty="$(prettify_num "$chapter")"
		page=1

		while :; do
			update_progress "$chapter_pretty" "$page" "$chapters_downloaded" "$pages_downloaded"
			image="$(get_image_name "$chapter" "$page")"

			if [[ ! -f "$images_dir/$image" ]] && ! download_image "$image"; then
			        if [[ "$page" -eq 1 ]]; then
					if get_new_host "$image" && download_image "$image"; then
		        			continue
		        		fi
			        	if [[ "$ignore_if_fail" == true ]] || is_decimal "$chapter_pretty"; then
			        		break
					fi
					return 1
				else
					break
				fi
			fi

			((page++))
			((pages_downloaded++))
		done

		[[ "$page" -gt 1 ]] && ((chapters_downloaded++))
		[[ "$chapter" == "$to" ]] || [[ "$chapters_downloaded" == "$limit" ]] && update_progress "$chapter_pretty" "$page" "$chapters_downloaded" "$pages_downloaded"
		[[ "$chapters_downloaded" == "$limit" ]] && break
	done
}

process_images() {
	if [[ "$no_pdf" == true ]]; then
		echo "Images downloaded to $images_dir"
	elif img2pdf "$images_dir"/*.png -o "$output_pdf"; then
		echo "PDF created: $output_pdf"
		{ [[ "$keep_images" == true ]] && echo "$img_dl_info"; } || rm -rf "$images_dir"
	else
		echo -e "Error: Failed to create PDF.\n$img_dl_info" >&2
		exit 1
	fi
}

#######################################
# Main program
#######################################

main() {
	local pos_args title_arg from_arg to_arg arg opt img_dir_info

	for arg in "$@"; do
	    shift
	    case "$arg" in
		--title)		set -- "$@" -T ;;
		--from)			set -- "$@" -f ;;
		--to)			set -- "$@" -t ;;
		--chapters)		set -- "$@" -c ;;
		--step)			set -- "$@" -s ;;
		--limit)		set -- "$@" -l ;;
		--output)		set -- "$@" -o ;;
		--output-dir)		set -- "$@" -O ;;
		--keep)			set -- "$@" -k ;;
		--no-pdf)		set -- "$@" -n ;;
		--ignore-if-fail)	set -- "$@" -i ;;
		--help)			set -- "$@" -h ;;
	        *)			set -- "$@" "$arg" ;;
	    esac
	done
	while getopts "T:f:t:c:s:l:o:d:knih" opt; do
		case "$opt" in
			o) output_pdf="$OPTARG" ;;
			d) output_dir="$OPTARG" ;;
			k) keep_images=true ;;
			n) no_pdf=true ;;
			s) step="$OPTARG" ;;
			h) display_help; exit 0 ;;
			T) title="$OPTARG" ;;
			f) from="$OPTARG" ;;
			t) to="$OPTARG" ;;
			c) chapters="$OPTARG" ;;
			i) ignore_if_fail=true ;;
			l) limit="$OPTARG" ;;
			\?) echo -e "Error: Invalid option: -$OPTARG\n$help_short" >&2; exit 1 ;;
		esac
	done
	shift $((OPTIND-1))

	pos_args=("$@")
	title_arg="${pos_args[0]:-}"
	from_arg="${pos_args[1]:-}"
	to_arg="${pos_args[2]:-}"

	resolve_arguments "$title_arg" "$from_arg" "$to_arg"
	resolve_dirs

	echo "Title: $title"
	echo "From:  $(prettify_num "$from")"
	echo -e "To:    $(prettify_num "$to")\n"

	img_dir_info="Images"
	[[ "$keep_images" == false ]] && img_dir_info="Temporary images"

	echo "$img_dir_info dir: ""$images_dir"""
	[[ "$no_pdf" == false ]] && echo "PDF file: ""$output_pdf"""
	echo ""

	find_initial_host
	download_images
	process_images
}

main "$@"
