{
    "layer": "top",
    "position": "top",
    "width": "100%",
    "margin": "0 0 0 0",
    "spacing": 0,
    
    "modules-left": [
	"sway/workspaces",
	"sway/mode",
    ],
    
    "modules-center": [
	"custom/spotify",
	"custom/time_center",
	"custom/date_center"
    ],
    
    "modules-right": [
	"custom/space",
        "custom/peripherals",
        "pulseaudio",
	"custom/vpn",
        "network",
        "sway/language",
        "backlight",
        "battery",
        "custom/mouse_bat",
        "custom/time_right",
        "custom/date_right"
    ],

    "sway/workspaces": {
	"disable-scroll": true,
	"all-outputs": true,
	"format": "{icon}",
	"format-icons": {
	    "1": " ",
	    "2": " ",
	    "3": " ",
	    "4": " ",
	    "5": "󱔗",
	    "6": " ",
	    "7": " ",
	    "8": "8",
	    "9": "9",
	    "10": "10",
	},
	"disable-click": true,
	"tooltip": false,
    },

    "sway/language": {
        "format": "{short} |",
        "min-length": 4,
	"tooltip": false,
    },

    "battery": {
        "states": {
            "warning": 30,
        },
        "format": " {icon} {capacity}% ",
        "format-charging": " {icon} 󱐋 {capacity}% ",
        "format-plugged": " {icon}  {capacity}% ",
        "format-warning": " {icon}  {capacity}% ",
        "format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰁹"],
        // power draw (replaces custom/consumption), shown only while discharging
        "format-discharging": " {power:.2f} W | {icon} {capacity}% ",
        "format-discharging-warning": " {power:.2f} W | {icon}  {capacity}% ",
        "interval": 3,
	"tooltip": false,
    },

    "clock": {
        "format": "󱑂 {:%H:%M:%S |  %a %d/%m/%Y} ",
        "interval": 1,
	"tooltip": false,
    },

    "network": {
        "format-wifi": "  {essid} ({signalStrength}%) | ",
        "format-ethernet": "  | ",
        "format-disconnected": "󰤮  | ",
	"tooltip": false,
    },

    "pulseaudio": {
        "format": "{icon} {volume}% | {format_source}",
        "format-bluetooth": "{icon}  {volume}% | {format_source}",
        "format-bluetooth-muted": "{icon}    | {format_source}",
        "format-muted": "  | {format_source}",
        "format-source": " | ",
        "format-source-muted": "  | ",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰓔",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", " "],
        },
	"tooltip": false,
    },

    "custom/sep": {
	"format": " | ",
	"tooltip": false,
    },

    // Event-driven modules: the scripts in scripts/event-based/ run
    // continuously and print a line only when something changes.
    // Never give them an "interval": any numeric interval (even 0, which
    // waybar clamps to 1 ms) turns them back into polled scripts.

    "backlight": {
	"device": "intel_backlight",
	"format": " 󰖨 {percent}% |",
	"tooltip": false,
    },

    "custom/mouse_bat": {
	"exec": "~/.config/waybar/scripts/event-based/mouse_bat",
	"format": "{} | ",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/peripherals": {
        "exec": "~/.config/waybar/scripts/event-based/peripherals",
        "format": "{} | ",
	"restart-interval": 10,
	"tooltip": false,
    },

    // static text, no exec, nothing to run
    "custom/space": {
	"format": ".",
	"tooltip": false,
    },

    "custom/spotify": {
	"exec": "~/.config/waybar/scripts/event-based/spotify",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/vpn": {
	"exec": "~/.config/waybar/scripts/event-based/vpn",
	"format": "{} ",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/time_center": {
	"exec": "~/.config/waybar/scripts/event-based/clock time center",
	"format": "󱑂 {} | ",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/date_center": {
	"exec": "~/.config/waybar/scripts/event-based/clock date center",
	"format": " {}",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/time_right": {
	"exec": "~/.config/waybar/scripts/event-based/clock time right",
	"format": "| 󱑂 {} | ",
	"restart-interval": 10,
	"tooltip": false,
    },

    "custom/date_right": {
	"exec": "~/.config/waybar/scripts/event-based/clock date right",
	"format": " {} ",
	"restart-interval": 10,
	"tooltip": false,
    },

    // replaces custom/resize-mode: shown only while a sway mode is active
    "sway/mode": {
	"format": "{}",
	"tooltip": false,
    },
}
